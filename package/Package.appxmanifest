<?xml version="1.0" encoding="utf-8"?>
<!-- melee-xbox (Recompilaciones) - el manifiesto del paquete UWP.

     CAMBIALO antes de empaquetar: si el Publisher no es exactamente el sujeto del certificado con
     que firmas, la firma falla.

       - Identity Name / Publisher / PhoneProductId / PublisherDisplayName: los tuyos.
       - La Version la pone tools\empaquetar_uwp.py, y sube en cada paquete nuevo.

     docs/INSTALL.es.md §5. -->
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:mp="http://schemas.microsoft.com/appx/2014/phone/manifest"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap mp rescap">

  <Identity
    Name="CHANGE-ME-Melee"
    Publisher="CN=CHANGE-ME"
    Version="@VERSION@"
    ProcessorArchitecture="x64" />

  <mp:PhoneIdentity PhoneProductId="00000000-0000-0000-0000-000000000001" PhonePublisherId="00000000-0000-0000-0000-000000000000"/>

  <Properties>
    <DisplayName>Super Smash Bros Melee Decomp</DisplayName>
    <PublisherDisplayName>CHANGE-ME</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Universal" MinVersion="10.0.19041.0" MaxVersionTested="10.0.26100.0" />
    <PackageDependency Name="Microsoft.VCLibs.140.00" MinVersion="14.0.33519.0" Publisher="CN=Microsoft Corporation, O=Microsoft Corporation, L=Redmond, S=Washington, C=US" />
  </Dependencies>

  <Resources>
    <Resource Language="en-us"/>
  </Resources>

  <Applications>
    <Application Id="App"
      Executable="melee.exe"
      EntryPoint="uwp.App">
      <uap:VisualElements
        DisplayName="CHANGE-ME-Melee"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png"
        Description="Port UWP de melee-pc (decomp de Super Smash Bros. Melee) para Xbox Series en modo desarrollador"
        BackgroundColor="transparent">
        <uap:DefaultTile Wide310x150Logo="Assets\Wide310x150Logo.png"/>
        <uap:SplashScreen Image="Assets\SplashScreen.png" />
      </uap:VisualElements>
    </Application>
  </Applications>

  <Capabilities>
    <rescap:Capability Name="runFullTrust"/>
    <rescap:Capability Name="expandedResources" />
    <Capability Name="internetClient" />
    <Capability Name="privateNetworkClientServer" />
    <Capability Name="codeGeneration"/>
  </Capabilities>
</Package>
